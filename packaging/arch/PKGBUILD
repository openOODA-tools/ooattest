# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ooattest-bin
_pkgname=ooattest
pkgver=0.2.0
pkgrel=1
pkgdesc="Attests system state and measured boot hashes using TPM2 hardware security chips."
arch=('x86_64')
url="https://github.com/openOODA-tools/ooattest"
license=('Apache-2.0')
depends=('glibc')
provides=('ooattest')
conflicts=('ooattest')
source_x86_64=("${url}/releases/download/v${pkgver}/ooattest-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ooattest-linux-x86_64" "${pkgdir}/usr/bin/ooattest"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ooattest-uninstall"
}
